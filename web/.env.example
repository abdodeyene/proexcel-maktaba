# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Authentication — use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET="change-me-to-a-long-random-string"

# Supabase (optional — if not set, uploads go to /public/uploads locally)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Setup / Seed protection — required to use /api/auth/setup and /api/seed
# Set to a strong random string, then REMOVE after first use in production
SETUP_SECRET="change-me-strong-secret"

# Admin password used by /api/auth/setup and /api/seed to create the admin account
ADMIN_PASSWORD="change-me-strong-password"
