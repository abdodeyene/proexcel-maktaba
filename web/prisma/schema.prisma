generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())

  @@map("users")
}

model Product {
  id             Int      @id @default(autoincrement())
  title          String
  author         String?
  price          Float
  compareAtPrice Float?
  category       String?
  niveau         String?
  subject        String?
  g1             String?  @default("#1a237e")
  g2             String?  @default("#3949ab")
  emoji          String?  @default("📦")
  stock          Int      @default(0)
  rating         Float    @default(4.5)
  reviewCount    Int      @default(0)
  isPromo        Boolean  @default(false)
  isBestOffer    Boolean  @default(false)
  isNew          Boolean  @default(false)
  description    String?
  titleAr        String?
  descriptionAr  String?
  variants       Json?
  media          Json?
  colors         Json?
  costPrice      Float?
  reviews        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("products")
}

model Category {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  emoji String? @default("📚")
  color String?
  glow  String?
  image String?
  count Int     @default(0)

  @@map("categories")
}

model Order {
  id        Int      @id @default(autoincrement())
  orderNum  String   @unique
  name      String
  phone     String
  address   String
  city      String
  total     Float
  promoCode String?
  discount  Float?
  status    String   @default("pending")
  cart      Json
  date      DateTime @default(now())

  @@map("orders")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String?
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("push_subscriptions")
}

model HeroSlide {
  id              Int      @id @default(autoincrement())
  tag             String   @default("")
  tagAr           String   @default("")
  title           String   @default("")
  titleAr         String   @default("")
  subtitle        String   @default("")
  subtitleAr      String   @default("")
  ctaText         String   @default("")
  ctaTextAr       String   @default("")
  ctaLink         String   @default("/")
  ctaText2        String   @default("")
  ctaLink2        String   @default("/")
  imageUrl        String?
  bgPosition      String   @default("center")
  textAlign       String   @default("center")
  overlayStrength String   @default("medium")
  titleColor      String   @default("")
  subtitleColor   String   @default("")
  tagColor        String   @default("")
  isActive        Boolean  @default(true)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("hero_slides")
}

model SliderButtonStyle {
  id                  String  @id @default("default")
  bgType              String  @default("solid")
  bgColor             String  @default("#ffffff")
  bgGradientStart     String  @default("#e11d2e")
  bgGradientEnd       String  @default("#000000")
  bgGradientDirection String  @default("135deg")
  textColor           String  @default("#111827")
  borderRadius        String  @default("999px")
  paddingX            String  @default("28px")
  paddingY            String  @default("14px")
  fontSize            String  @default("0.9rem")
  fontWeight          String  @default("700")
  showArrowDot        Boolean @default(true)
  arrowDotColor       String  @default("#e11d2e")

  @@map("slider_button_styles")
}
